rules_version = '2';

// -----------------------------------------------------------------------
// How admin identity works:
// Admins sign in with Firebase Auth email/password (see AdminLogin.jsx).
// Everyone else (students) signs in anonymously (see firebase.js ensureAuth()).
// We tell them apart using request.auth.token.firebase.sign_in_provider,
// which is "password" for admins and "anonymous" for students.
// -----------------------------------------------------------------------

function isAdmin() {
  return request.auth != null &&
         request.auth.token.firebase.sign_in_provider == 'password';
}

function isSignedIn() {
  return request.auth != null;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Quiz bank: only admins can create, edit, delete, or list quizzes.
    match /quizzes/{quizId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Sessions: admins create/control them. Students (anonymous, signed in)
    // may only read session state — never write it directly; all session
    // state changes go through admin-only actions (start/advance/reveal/finish).
    match /sessions/{code} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // Participants: a student may create/update ONLY their own participant
      // doc (doc id == their auth uid), and read the roster to show names.
      match /participants/{participantId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == participantId;
        allow delete: if isAdmin();
      }

      // Live tallies: any signed-in participant can bump a count (this is a
      // low-stakes, anonymous vote counter — not attempt data), admins can
      // read for hosting.
      match /tallies/{questionIndex} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      // Attempts: a student can create their own attempt and update it
      // (finalize their own score). Admins can read all attempts for a
      // session to show submission counts.
      match /attempts/{attemptId} {
        allow read: if isAdmin() ||
          (isSignedIn() && resource.data.participantId == request.auth.uid);
        allow create: if isSignedIn() && request.resource.data.participantId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.participantId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }
  }
}
